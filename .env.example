# Copia questo file in ".env" e incolla la tua API key gratuita di The Odds API.
# Registrazione: https://the-odds-api.com  (piano gratuito: 500 richieste/mese)

ODDS_API_KEY=incolla_qui_la_tua_key

# --- Cosa monitorare -------------------------------------------------------

# Sport da interrogare, separati da virgola.
#   upcoming = prossimi eventi su TUTTI gli sport, al costo di 1 sola chiamata
#              (il modo piu' economico per campionare il mercato)
# Esempi alternativi: soccer_italy_serie_a,basketball_nba,tennis_atp_us_open
ODDS_SPORTS=upcoming

# Regioni bookmaker. ATTENZIONE AL COSTO: costo = mercati x regioni.
# Con una sola regione ogni passata costa 1 richiesta invece di 2.
# eu = Europa continentale (c'e' Betfair), uk = Regno Unito
ODDS_REGIONS=eu

# --- Soglie e filtri anti-falso-positivo -----------------------------------

# Profitto minimo NETTO per segnalare un arbitraggio (0.005 = 0,5%)
MIN_ARB_PROFIT=0.005

# Ignora quote sopra questo valore: le quote monstre (100, 501...) sono
# residui o errori, non prezzi su cui si punta davvero. Generano arb finti.
MAX_ODDS=30

# Numero minimo di bookmaker distinti dietro un arbitraggio.
# Con 2-3 book il rumore da quote stantie e' altissimo.
MIN_BOOKMAKERS=4

# Minuti minimi che devono mancare all'inizio del match.
# I match gia' partiti hanno quote in-play o stantie: sono la prima
# sorgente di arbitraggi finti. 15 = scarta tutto cio' che parte fra meno di 15 min.
MIN_MINUTI_ALL_INIZIO=15

# Commissione delle exchange (Betfair 2-5% sulle vincite nette).
# Serve a calcolare il margine VERO, non quello teorico.
BETFAIR_COMMISSION=0.05

# Solo questi bookmaker (separati da virgola). Vuoto = tutti.
# Da valorizzare con i book su cui hai davvero un conto aperto e legale in Italia.
BOOK_WHITELIST=

# --- Esecuzione ------------------------------------------------------------

# Minuti fra una passata e l'altra quando si lancia con --loop.
# 120 min x 1 richiesta = ~360 richieste/mese, sta dentro il piano gratuito.
LOOP_MINUTES=120

# Puntata totale usata solo per mostrare come dividere gli importi (in euro)
PUNTATA_ESEMPIO=100

# ===========================================================================
#  Betfair Exchange Italia
# ===========================================================================

# Delayed App Key (gratuita). La Live costa 499 GBP e non serve per misurare.
BETFAIR_APP_KEY=

# Credenziali del conto betfair.it. Se la password contiene $ o altri simboli,
# racchiudila fra apici singoli: BETFAIR_PASSWORD='abc$def'
BETFAIR_USERNAME=
BETFAIR_PASSWORD=

BETFAIR_MAX_MERCATI=20
BETFAIR_ORE_AVANTI=48
BETFAIR_INTERVALLO_SEC=60
BETFAIR_MIN_SCAMBIATO=1000

# ===========================================================================
#  Worker automatico (src/worker.py)
# ===========================================================================

# Tetto di crediti The Odds API per passata. Con 500 crediti/mese gratuiti:
# 6 crediti x 2 passate al giorno x 30 = 360, sta dentro con margine.
CREDITI_PER_PASSATA=6

# Margine minimo per registrare un'occasione, e per farne partire una mail.
MIN_PROFIT=0.5
MIN_PROFIT_MAIL=1.0

PUNTATA_MAX=100
ORE_AVANTI=72

# ===========================================================================
#  Supabase (database + pannello)
# ===========================================================================

# Impostazioni > API. Il worker usa la service_role key (scrive, ignora le RLS).
# Se restano vuote, il worker salva su file in data/ e continua a funzionare.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# ===========================================================================
#  Notifiche via mail
# ===========================================================================

# Strada 1 — Resend: nessun server SMTP da configurare.
RESEND_API_KEY=
EMAIL_DA=onboarding@resend.dev

# Strada 2 — SMTP qualunque (es. Gmail con "password per le app").
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# Dove arrivano gli avvisi
EMAIL_A=
